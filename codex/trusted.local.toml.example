# Optional starting point for this machine's gitignored trusted.local.toml.
# Alternatively, make -C codex export captures its live private settings.
# Never copy another machine's trust entries here. See README.md for ownership.
#
# Private projects, paths, hooks, MCP servers and marketplaces belong here.
# Shared tui.status_line can coexist with local TUI state:
#
# [tui]
# screen_reader_detection_done = true
#
# [projects."/path/to/your/project"]
# trust_level = "trusted"
